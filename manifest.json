{
  "schemaVersion": 1,
  "id": "io.github.codemonkey76.wireguard",
  "name": "WireGuard",
  "version": "1.0.0",
  "author": "Shane Poppleton",
  "description": "WireGuard tunnel status, live traffic, latency and connect/disconnect",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "WireGuard",
    "description": "WireGuard tunnel status, live traffic, latency and connect/disconnect",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshSeconds": 5,
      "notify": true
    },
    "schema": [
      {
        "key": "refreshSeconds",
        "type": "integer",
        "label": "Refresh interval while closed (seconds)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "notify",
        "type": "boolean",
        "label": "Notify when a tunnel drops or recovers",
        "defaultValue": true
      }
    ]
  }
}
